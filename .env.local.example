# Copy this file to .env.local and paste your Meta Model API key:
#   cp .env.local.example .env.local
#
# Then test live connectivity with:
#   php bin/console app:test-ai --force-refresh

META_AI_API_KEY="paste-your-meta-api-key-here"
META_AI_ENDPOINT="https://api.meta.ai/v1"
META_AI_MODEL="muse-spark-1.3"
META_AI_CACHE_ENABLED=1
META_AI_BUDGET_CREDITS=50.0
