{% extends 'base.html.twig' %}

{#
    Displays account creation form with company and role configuration
#}

{% block title %}PromiseGap | Create account{% endblock %}

{% block body %}
<div style="min-height: 960px; box-sizing: border-box; background: #0E1116; color: #E8ECF1; font-family: 'IBM Plex Sans', system-ui, sans-serif; display: flex; flex-wrap: wrap; align-items: stretch;">

    <!-- Left Column: Form -->
    <div style="flex: 1 1 520px; box-sizing: border-box; padding: 32px 48px; display: flex; flex-direction: column; justify-content: space-between; gap: 40px;">
        <a href="{{ path('app_landing') }}" style="display: inline-flex; align-items: center; gap: 12px; width: fit-content; text-decoration: none; color: #E8ECF1;">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                <rect x="2" y="5" width="14" height="14" rx="3" stroke="#7FA3FF" stroke-width="2"/>
                <rect x="12" y="9" width="14" height="14" rx="3" stroke="#B7C0CC" stroke-width="2"/>
            </svg>
            <span style="font-size: 18px; font-weight: 700; letter-spacing: -0.01em;">PromiseGap</span>
        </a>

        <div style="width: 100%; max-width: 400px; display: flex; flex-direction: column; gap: 24px;">
            <div style="display: flex; flex-direction: column; gap: 10px;">
                <h1 style="margin: 0; font-size: 36px; letter-spacing: -0.02em; font-weight: 700;">Create your account</h1>
                <p style="margin: 0; font-size: 16px; line-height: 1.5; color: #9BA5B3;">Audit your first contract in a few minutes.</p>
            </div>

            {% if app.user %}
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; border-radius: 10px; background: rgba(127,163,255,0.12); border: 1px solid #7FA3FF; font-size: 14px; color: #E8ECF1;">
                    <span>Signed in as <strong>{{ app.user.userIdentifier }}</strong></span>
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <a href="{{ path('app_cockpit') }}" style="color: #7FA3FF; font-weight: 600; text-decoration: none;">Open Cockpit →</a>
                        <a href="{{ logout_path() }}" style="color: #FF7B7B; text-decoration: none;">Sign out</a>
                    </div>
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_register') }}" style="display: flex; flex-direction: column; gap: 18px;">
                <input type="hidden" name="_token" value="{{ csrf_token('register') }}">
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <label for="name" style="font-size: 14px; font-weight: 500;">Full name</label>
                    <input id="name" name="name" type="text" autocomplete="name" placeholder="Your name" required style="box-sizing: border-box; width: 100%; min-height: 48px; padding: 0 14px; background: #151A21; border: 1px solid #3A4553; border-radius: 10px; color: #E8ECF1; font: inherit; font-size: 16px;">
                </div>

                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <label for="email" style="font-size: 14px; font-weight: 500;">Work email</label>
                    <input id="email" name="email" type="email" autocomplete="email" placeholder="you@company.com" required style="box-sizing: border-box; width: 100%; min-height: 48px; padding: 0 14px; background: #151A21; border: 1px solid #3A4553; border-radius: 10px; color: #E8ECF1; font: inherit; font-size: 16px;">
                </div>

                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <label for="company" style="font-size: 14px; font-weight: 500;">Company</label>
                    <input id="company" name="company" type="text" autocomplete="organization" placeholder="Company name" required style="box-sizing: border-box; width: 100%; min-height: 48px; padding: 0 14px; background: #151A21; border: 1px solid #3A4553; border-radius: 10px; color: #E8ECF1; font: inherit; font-size: 16px;">
                </div>

                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <label for="password" style="font-size: 14px; font-weight: 500;">Password</label>
                    <input id="password" name="password" type="password" autocomplete="new-password" placeholder="At least 12 characters" required style="box-sizing: border-box; width: 100%; min-height: 48px; padding: 0 14px; background: #151A21; border: 1px solid #3A4553; border-radius: 10px; color: #E8ECF1; font: inherit; font-size: 16px;">
                    <span style="font-size: 13px; color: #9BA5B3;">Use 12 characters or more, with a mix of letters and numbers.</span>
                </div>

                <label style="display: flex; align-items: flex-start; gap: 10px; min-height: 44px; font-size: 14px; line-height: 1.5; color: #B7C0CC; cursor: pointer;">
                    <input type="checkbox" required style="width: 18px; height: 18px; margin-top: 2px; accent-color: #7FA3FF;">
                    <span>I accept the terms of use and the privacy policy.</span>
                </label>

                <button type="submit" style="display: flex; align-items: center; justify-content: center; min-height: 52px; background: #7FA3FF; color: #0B1020; border: 0; border-radius: 12px; font-size: 17px; font-weight: 600; cursor: pointer;">
                    Create account
                </button>
            </form>

            <div style="display: flex; flex-direction: column; gap: 10px; font-size: 15px; color: #9BA5B3;">
                <span>Already registered? <a href="{{ path('app_login') }}">Sign in</a></span>
                <span>Not ready yet? <a href="{{ path('app_demo') }}">Try a demo</a> first.</span>
            </div>
        </div>

        <span style="font-size: 13px; color: #9BA5B3;">PromiseGap · Meta AI Hackathon</span>
    </div>

    <!-- Right Column: Brand Showcase -->
    <div style="flex: 1 1 520px; box-sizing: border-box; padding: 48px; background: #151A21; border-left: 1px solid #2A323D; display: flex; flex-direction: column; justify-content: center; gap: 32px;">
        <span style="font-family: 'IBM Plex Mono', monospace; font-size: 13px; letter-spacing: 0.08em; color: #7FA3FF;">WHAT YOU GET</span>
        <h2 style="margin: 0; font-size: 32px; line-height: 1.2; font-weight: 700;">Close contracts with proof, not promises.</h2>

        <div style="display: flex; flex-direction: column; gap: 16px;">
            <div style="display: flex; gap: 14px; align-items: flex-start;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4ADE9A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.7 2.7L16 9.5"/></svg>
                <div style="display: flex; flex-direction: column; gap: 2px;">
                    <span style="font-size: 16px; font-weight: 600;">Automated commitment extraction</span>
                    <span style="font-size: 14px; color: #9BA5B3;">SLAs, timelines, architectures and security guarantees parsed instantly.</span>
                </div>
            </div>
            <div style="display: flex; gap: 14px; align-items: flex-start;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4ADE9A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.7 2.7L16 9.5"/></svg>
                <div style="display: flex; flex-direction: column; gap: 2px;">
                    <span style="font-size: 16px; font-weight: 600;">Verbatim-backed cross-examination</span>
                    <span style="font-size: 14px; color: #9BA5B3;">Every discrepancy mapped to exact page quotes from technical specifications.</span>
                </div>
            </div>
            <div style="display: flex; gap: 14px; align-items: flex-start;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4ADE9A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.7 2.7L16 9.5"/></svg>
                <div style="display: flex; flex-direction: column; gap: 2px;">
                    <span style="font-size: 16px; font-weight: 600;">Collaborative audit cockpit</span>
                    <span style="font-size: 14px; color: #9BA5B3;">Share audit verdicts with legal, CTO and procurement teams.</span>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}
