{% extends 'base.html.twig' %}

{#
    Displays the sign-in form with company SSO option and audit summary showcase
    
    @param string last_username Last entered username or email
    @param mixed error Potential authentication error
#}

{% block title %}PromiseGap | Sign in{% endblock %}

{% block body %}
<div style="min-height: 900px; box-sizing: border-box; background: #0E1116; color: #E8ECF1; font-family: 'IBM Plex Sans', system-ui, sans-serif; display: flex; flex-wrap: wrap; align-items: stretch;">

    <!-- Left Column: Form -->
    <div style="flex: 1 1 520px; box-sizing: border-box; padding: 32px 48px; display: flex; flex-direction: column; justify-content: space-between; gap: 48px;">
        <a href="{{ path('app_landing') }}" style="display: inline-flex; align-items: center; gap: 12px; width: fit-content; text-decoration: none; color: #E8ECF1;">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                <rect x="2" y="5" width="14" height="14" rx="3" stroke="#7FA3FF" stroke-width="2"/>
                <rect x="12" y="9" width="14" height="14" rx="3" stroke="#B7C0CC" stroke-width="2"/>
            </svg>
            <span style="font-size: 18px; font-weight: 700; letter-spacing: -0.01em;">PromiseGap</span>
        </a>

        <div style="width: 100%; max-width: 400px; display: flex; flex-direction: column; gap: 28px;">
            <div style="display: flex; flex-direction: column; gap: 10px;">
                <h1 style="margin: 0; font-size: 36px; letter-spacing: -0.02em; font-weight: 700;">Welcome back</h1>
                <p style="margin: 0; font-size: 16px; line-height: 1.5; color: #9BA5B3;">Sign in to reopen your audits and run new ones.</p>
            </div>

            {% if app.user %}
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; border-radius: 10px; background: rgba(127,163,255,0.12); border: 1px solid #7FA3FF; font-size: 14px; color: #E8ECF1;">
                    <span>Signed in as <strong>{{ app.user.userIdentifier }}</strong></span>
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <a href="{{ path('app_cockpit') }}" style="color: #7FA3FF; font-weight: 600; text-decoration: none;">Open Cockpit →</a>
                        <a href="{{ logout_path() }}" style="color: #FF7B7B; text-decoration: none;">Sign out</a>
                    </div>
                </div>
            {% endif %}

            {% if error %}
                <div style="padding: 12px; border-radius: 8px; background: rgba(255,123,123,0.15); border: 1px solid #FF7B7B; color: #FF7B7B; font-size: 14px;">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" style="display: flex; flex-direction: column; gap: 20px;">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <label for="email" style="font-size: 14px; font-weight: 500;">Work email</label>
                    <input id="email" type="email" name="_username" value="{{ last_username|default('admin@promisegap.ai') }}" autocomplete="email" placeholder="admin@promisegap.ai" required style="box-sizing: border-box; width: 100%; min-height: 48px; padding: 0 14px; background: #151A21; border: 1px solid #3A4553; border-radius: 10px; color: #E8ECF1; font: inherit; font-size: 16px;">
                </div>

                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px;">
                        <label for="password" style="font-size: 14px; font-weight: 500;">Password</label>
                        <a href="{{ path('app_forgot_password') }}" style="font-size: 14px; text-decoration: none;">Forgot password?</a>
                    </div>
                    <input id="password" type="password" name="_password" value="admin123" autocomplete="current-password" placeholder="admin123" required style="box-sizing: border-box; width: 100%; min-height: 48px; padding: 0 14px; background: #151A21; border: 1px solid #3A4553; border-radius: 10px; color: #E8ECF1; font: inherit; font-size: 16px;">
                </div>

                <label style="display: flex; align-items: center; gap: 10px; min-height: 44px; font-size: 14px; color: #B7C0CC; cursor: pointer;">
                    <input type="checkbox" name="_remember_me" style="width: 18px; height: 18px; accent-color: #7FA3FF;">
                    Keep me signed in on this device
                </label>

                <button type="submit" style="display: flex; align-items: center; justify-content: center; min-height: 52px; background: #7FA3FF; color: #0B1020; border: 0; border-radius: 12px; font-size: 17px; font-weight: 600; cursor: pointer;">
                    Sign in
                </button>
            </form>

            <div style="display: flex; align-items: center; gap: 12px; color: #9BA5B3; font-size: 13px;">
                <div style="flex: 1; height: 1px; background: #2A323D;"></div>or<div style="flex: 1; height: 1px; background: #2A323D;"></div>
            </div>

            <a href="{{ path('app_welcome') }}" style="display: flex; align-items: center; justify-content: center; gap: 10px; min-height: 48px; background: transparent; color: #E8ECF1; border: 1px solid #4A5565; border-radius: 12px; font: inherit; font-size: 16px; text-decoration: none;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                Continue with company SSO
            </a>

            <div style="display: flex; flex-direction: column; gap: 10px; font-size: 15px; color: #9BA5B3;">
                <span>New to PromiseGap? <a href="{{ path('app_register') }}">Create an account</a></span>
                <span>Just looking? <a href="{{ path('app_demo') }}">Try a demo</a>, no account needed.</span>
            </div>
        </div>

        <span style="font-size: 13px; color: #9BA5B3;">PromiseGap · Meta AI Hackathon</span>
    </div>

    <!-- Right Column: Last Audit Preview -->
    <div style="flex: 1 1 520px; box-sizing: border-box; padding: 48px; background: #151A21; border-left: 1px solid #2A323D; display: flex; flex-direction: column; justify-content: center; gap: 24px;">
        <span style="font-family: 'IBM Plex Mono', monospace; font-size: 12px; letter-spacing: 0.08em; color: #9BA5B3;">LAST AUDIT · CLOUD HOSTING CONTRACT</span>
        <div style="display: flex; flex-direction: column; gap: 10px; padding: 20px; background: #0E1116; border: 1px solid #2A323D; border-top: 3px solid #7FA3FF; border-radius: 12px;">
            <span style="font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: #7FA3FF;">PROPOSAL · §2.1</span>
            <p style="margin: 0; font-size: 18px; line-height: 1.55;">The platform delivers <mark style="background: rgba(127,163,255,0.28); color: #E8ECF1; padding: 1px 3px; border-radius: 3px;">99.99% availability</mark>.</p>
        </div>
        <div style="display: flex; flex-direction: column; gap: 10px; padding: 20px; background: #0E1116; border: 1px solid #2A323D; border-top: 3px solid #B7C0CC; border-radius: 12px;">
            <span style="font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: #B7C0CC;">TECH SPECS · §4.2</span>
            <p style="margin: 0; font-size: 18px; line-height: 1.55;">Target monthly availability is <mark style="background: rgba(245,176,74,0.30); color: #E8ECF1; padding: 1px 3px; border-radius: 3px;">99.5%</mark>.</p>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: 12px; font-size: 14px;">
            <span style="padding: 6px 12px; border-radius: 999px; background: rgba(245,176,74,0.14); color: #F5B04A; font-weight: 600;">2 contradictory</span>
            <span style="padding: 6px 12px; border-radius: 999px; background: rgba(255,123,123,0.14); color: #FF7B7B; font-weight: 600;">3 unsupported</span>
            <span style="padding: 6px 12px; border-radius: 999px; background: rgba(74,222,154,0.14); color: #4ADE9A; font-weight: 600;">2 supported</span>
        </div>
    </div>

</div>
{% endblock %}
