{% extends 'base.html.twig' %}

{#
    Displays password recovery request form with submission confirmation state
    
    @param bool isSent Whether the reset email has been dispatched
#}

{% block title %}PromiseGap | Forgot password{% endblock %}

{% block body %}
<div style="min-height: 900px; box-sizing: border-box; background: #0E1116; color: #E8ECF1; font-family: 'IBM Plex Sans', system-ui, sans-serif; display: flex; flex-direction: column;">

    <!-- Topbar -->
    <div style="padding: 32px 48px;">
        <a href="{{ path('app_landing') }}" style="display: inline-flex; align-items: center; gap: 12px; text-decoration: none; color: #E8ECF1;">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                <rect x="2" y="5" width="14" height="14" rx="3" stroke="#7FA3FF" stroke-width="2"/>
                <rect x="12" y="9" width="14" height="14" rx="3" stroke="#B7C0CC" stroke-width="2"/>
            </svg>
            <span style="font-size: 18px; font-weight: 700; letter-spacing: -0.01em;">PromiseGap</span>
        </a>
    </div>

    <!-- Centered Form Container -->
    <div style="flex: 1; display: flex; align-items: center; justify-content: center; padding: 24px 24px 96px;">
        <div style="width: 100%; max-width: 460px; box-sizing: border-box; display: flex; flex-direction: column; gap: 24px; padding: 36px; background: #151A21; border: 1px solid #2A323D; border-radius: 20px;">

            {% if not isSent %}
                <div style="display: flex; flex-direction: column; gap: 24px;">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#7FA3FF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="8" cy="15" r="4"/><path d="M11 12l9-9"/><path d="M16 7l3 3"/>
                    </svg>

                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        <h1 style="margin: 0; font-size: 30px; letter-spacing: -0.02em; font-weight: 700;">Forgot your password?</h1>
                        <p style="margin: 0; font-size: 16px; line-height: 1.55; color: #9BA5B3;">Enter the email you signed up with. We will send you a link to choose a new password.</p>
                    </div>

                    <form method="post" action="{{ path('app_forgot_password') }}" style="display: flex; flex-direction: column; gap: 18px;">
                        <div style="display: flex; flex-direction: column; gap: 8px;">
                            <label for="email" style="font-size: 14px; font-weight: 500;">Work email</label>
                            <input id="email" name="email" type="email" autocomplete="email" placeholder="you@company.com" required style="box-sizing: border-box; width: 100%; min-height: 48px; padding: 0 14px; background: #0E1116; border: 1px solid #3A4553; border-radius: 10px; color: #E8ECF1; font: inherit; font-size: 16px;">
                        </div>

                        <button type="submit" style="min-height: 52px; background: #7FA3FF; color: #0B1020; border: 0; border-radius: 12px; font: inherit; font-size: 17px; font-weight: 600; cursor: pointer;">
                            Send reset link
                        </button>
                    </form>

                    <a href="{{ path('app_login') }}" style="display: inline-flex; align-items: center; gap: 8px; width: fit-content; min-height: 44px; font-size: 15px; text-decoration: none;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg>
                        Back to sign in
                    </a>
                </div>
            {% else %}
                <div style="display: flex; flex-direction: column; gap: 24px;">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#4ADE9A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>
                    </svg>

                    <div style="display: flex; flex-direction: column; gap: 10px;">
                        <h1 style="margin: 0; font-size: 30px; letter-spacing: -0.02em; font-weight: 700;">Check your inbox</h1>
                        <p style="margin: 0; font-size: 16px; line-height: 1.55; color: #9BA5B3;">If an account exists for this address, a reset link is on its way. The link stays valid for 1 hour.</p>
                    </div>

                    <div style="display: flex; flex-direction: column; gap: 6px; padding: 16px; background: #0E1116; border: 1px solid #2A323D; border-radius: 12px; font-size: 14px; line-height: 1.5; color: #B7C0CC;">
                        <span style="font-weight: 600; color: #E8ECF1;">Nothing arrived?</span>
                        <span>Look in your spam folder, then request a new link.</span>
                    </div>

                    <a href="{{ path('app_reset_password') }}" style="display: flex; align-items: center; justify-content: center; min-height: 52px; background: #7FA3FF; color: #0B1020; border-radius: 12px; font-size: 17px; font-weight: 600; text-decoration: none;">
                        Open the reset link
                    </a>

                    <a href="{{ path('app_forgot_password') }}" style="display: inline-flex; align-items: center; justify-content: center; min-height: 44px; background: transparent; color: #7FA3FF; border: 0; font: inherit; font-size: 15px; cursor: pointer; text-decoration: none;">
                        Send another link
                    </a>
                </div>
            {% endif %}

        </div>
    </div>

</div>
{% endblock %}
