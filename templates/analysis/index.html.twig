{% extends 'base.html.twig' %}

{#
    Displays list of existing analysis workspaces and call-to-action to create a new audit
    
    @param array analyses List of Analysis entities ordered by date
#}

{% set is_fr = app.request.locale == 'fr' %}

{% block title %}PromiseGap | Commitment Audits{% endblock %}

{% block header %}
<header class="navbar bg-base-200 border-b border-base-300 px-4 lg:px-8 sticky top-0 z-50">
    <div class="navbar-start gap-3">
        <a href="{{ path('app_landing') }}" class="btn btn-ghost normal-case text-xl font-bold flex items-center gap-2">
            <span>Promise<span class="text-primary">Gap</span></span>
            <span class="badge badge-primary badge-outline badge-sm font-mono">ADMIN</span>
        </a>
    </div>
    <div class="navbar-center hidden md:flex">
        <ul class="menu menu-horizontal px-1 gap-2 font-medium">
            <li><a href="{{ path('app_analysis_index') }}" class="active">{{ is_fr ? 'Tous les audits' : 'All Audits' }}</a></li>
            <li><a href="{{ path('app_cockpit') }}">Cockpit</a></li>
            <li><a href="{{ path('app_demo') }}">{{ is_fr ? 'Démo' : 'Demo' }}</a></li>
        </ul>
    </div>
    <div class="navbar-end gap-3">
        {% include '_locale_switcher.html.twig' %}
        {% if app.user %}
            <span class="badge badge-neutral gap-2 py-3 px-3 hidden sm:inline-flex">
                <span class="w-2 h-2 rounded-full bg-success"></span>
                {{ app.user.userIdentifier }}
            </span>
            <a href="{{ logout_path() }}" class="btn btn-ghost btn-sm">{{ is_fr ? 'Déconnexion' : 'Sign out' }}</a>
        {% endif %}
    </div>
</header>
{% endblock %}

{% block body %}
<div class="container mx-auto px-4 lg:px-8 py-8 space-y-6">
    <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4">
        <div>
            <h1 class="text-3xl font-bold">Commercial Commitment Audits</h1>
            <p class="text-base-content/70">
                {{ is_fr
                    ? 'Supervisez les propositions commerciales confrontées aux spécifications techniques.'
                    : 'Audit commercial proposals against technical architecture and specs.' }}
            </p>
        </div>
        <div class="flex items-center gap-2">
            <a href="{{ path('app_cockpit') }}" class="btn btn-outline btn-sm sm:btn-md">
                {{ is_fr ? 'Ouvrir le Cockpit' : 'Open Cockpit' }}
            </a>
            <a href="{{ path('app_analysis_new') }}" class="btn btn-primary btn-sm sm:btn-md">
                + New Audit
            </a>
        </div>
    </div>

    {% if analyses is empty %}
        <div class="card bg-base-200 shadow-md p-8 text-center">
            <h2 class="text-xl font-semibold mb-2">{{ is_fr ? 'Aucun espace d\'audit' : 'No audit workspace yet' }}</h2>
            <p class="text-base-content/70 mb-4">
                {{ is_fr
                    ? 'Commencez par créer votre premier espace d\'audit pour analyser vos documents.'
                    : 'Start by creating your first audit workspace to cross-examine documents.' }}
            </p>
            <div>
                <a href="{{ path('app_analysis_new') }}" class="btn btn-primary">Create First Audit</a>
            </div>
        </div>
    {% else %}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for analysis in analyses %}
                <div class="card bg-base-200 border border-base-300 shadow-md hover:shadow-lg transition-shadow">
                    <div class="card-body">
                        <div class="flex items-start justify-between gap-2">
                            <h2 class="card-title text-lg">{{ analysis.title }}</h2>
                            <span class="badge badge-ghost font-mono text-xs">#{{ analysis.id }}</span>
                        </div>
                        <p class="text-sm text-base-content/70">
                            {{ is_fr ? 'Créé le' : 'Created on' }} {{ analysis.createdAt|date('M d, Y \\a\\t H:i') }}
                        </p>
                        {% if analysis.ownerIdentifier %}
                            <p class="text-xs text-base-content/60">
                                {{ is_fr ? 'Propriétaire :' : 'Owner:' }} <span class="font-medium text-base-content/80">{{ analysis.ownerIdentifier }}</span>
                            </p>
                        {% endif %}
                        <div class="flex flex-wrap items-center gap-2 mt-2">
                            <span class="badge {{ analysis.status.value == 'COMPLETED' ? 'badge-success' : (analysis.status.value == 'FAILED' ? 'badge-error' : 'badge-info') }}">
                                {{ analysis.status.value }}
                            </span>
                            <span class="badge badge-ghost">{{ analysis.documents|length }} document(s)</span>
                            <span class="badge badge-ghost">{{ analysis.commitments|length }} {{ is_fr ? 'promesse(s)' : 'commitment(s)' }}</span>
                        </div>
                        <div class="card-actions justify-end items-center gap-2 mt-4 pt-3 border-t border-base-300">
                            <a href="{{ path('app_audit_results', {'id': analysis.id}) }}" class="btn btn-sm btn-primary">
                                {{ is_fr ? 'Résultats IA' : 'AI Results' }}
                            </a>
                            <a href="{{ path('app_analysis_show', {'id': analysis.id}) }}" class="btn btn-sm btn-outline">Open</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
