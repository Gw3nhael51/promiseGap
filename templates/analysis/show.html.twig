{% extends 'base.html.twig' %}

{#
    Displays audit workspace details and attached commercial and technical documents
    
    @param Analysis analysis Analysis entity being viewed
#}

{% set is_fr = app.request.locale == 'fr' %}
{% set status_value = analysis.status.value %}

{% block title %}PromiseGap | {{ analysis.title }}{% endblock %}

{% block header %}
<header class="navbar bg-[#0E1116] border-b border-[#2A323D] px-4 lg:px-8 sticky top-0 z-50">
    <div class="navbar-start gap-3">
        <a href="{{ path('app_landing') }}" class="flex items-center gap-3 text-[#E8ECF1] hover:text-white no-underline">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                <rect x="2" y="5" width="14" height="14" rx="3" stroke="#7FA3FF" stroke-width="2"/>
                <rect x="12" y="9" width="14" height="14" rx="3" stroke="#B7C0CC" stroke-width="2"/>
            </svg>
            <span class="text-lg font-bold tracking-tight">PromiseGap</span>
        </a>
    </div>
    <div class="navbar-end gap-3">
        {% include '_locale_switcher.html.twig' %}
        <a href="{{ path(is_granted('ROLE_ADMIN') ? 'app_analysis_index' : 'app_cockpit') }}" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-[#2A323D] bg-[#151A21] hover:border-[#4A5565] text-xs font-medium text-[#E8ECF1] no-underline transition-colors">
            ← {{ is_fr ? 'Retour aux audits' : 'Back to Audits' }}
        </a>
        {% if app.user %}
            <div class="hidden sm:inline-flex items-center gap-2.5 px-3 py-1 rounded-full bg-[#151A21] border border-[#3A4553]">
                <span class="w-2 h-2 rounded-full bg-[#4ADE9A]"></span>
                <span class="text-xs text-[#E8ECF1]">{{ app.user.userIdentifier }}</span>
                {% if is_granted('ROLE_ADMIN') %}
                    <span class="px-2 py-0.5 rounded-full bg-[#F5B04A]/15 text-[#F5B04A] border border-[#F5B04A]/30 font-mono text-[11px] font-semibold">ADMIN</span>
                {% else %}
                    <span class="px-2 py-0.5 rounded-full bg-[#7FA3FF]/15 text-[#7FA3FF] border border-[#7FA3FF]/30 font-mono text-[11px] font-semibold">USER</span>
                {% endif %}
            </div>
            <a href="{{ logout_path() }}" class="text-xs font-medium text-[#FF7B7B] hover:text-[#ff9999] px-2 py-1 no-underline">{{ is_fr ? 'Déconnexion' : 'Sign out' }}</a>
        {% endif %}
    </div>
</header>
{% endblock %}

{% block body %}
<div class="container mx-auto px-4 lg:px-8 py-8 max-w-6xl space-y-8">
    <div class="flex flex-col sm:flex-row justify-between sm:items-start gap-4 pb-6 border-b border-[#2A323D]">
        <div class="space-y-2">
            <a href="{{ path(is_granted('ROLE_ADMIN') ? 'app_analysis_index' : 'app_cockpit') }}" class="inline-flex items-center gap-1 text-xs font-medium text-[#9BA5B3] hover:text-[#E8ECF1] no-underline">
                ← {{ is_fr ? 'Retour aux audits' : 'Back to Audits' }}
            </a>
            <div class="flex flex-wrap items-center gap-3">
                <h1 class="text-3xl font-bold text-[#E8ECF1] tracking-tight">{{ analysis.title }}</h1>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-md bg-[#1B222B] border border-[#2A323D] font-mono text-xs text-[#9BA5B3]">
                    #{{ analysis.id }}
                </span>
            </div>
            <p class="text-sm text-[#9BA5B3]">
                Workspace #{{ analysis.id }} • {{ is_fr ? 'Créé le' : 'Created on' }} {{ analysis.createdAt|date('M d, Y \\a\\t H:i') }}
                {% if analysis.ownerIdentifier %}
                    • {{ is_fr ? 'Propriétaire :' : 'Owner:' }} <span class="text-[#E8ECF1] font-medium">{{ analysis.ownerIdentifier }}</span>
                {% endif %}
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            {% if status_value == 'COMPLETED' %}
                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#4ADE9A]/12 text-[#4ADE9A] border border-[#4ADE9A]/30 font-mono text-xs font-semibold">
                    <span class="w-2 h-2 rounded-full bg-[#4ADE9A]"></span>
                    {{ status_value }}
                </span>
            {% elseif status_value == 'FAILED' %}
                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#FF7B7B]/12 text-[#FF7B7B] border border-[#FF7B7B]/30 font-mono text-xs font-semibold">
                    <span class="w-2 h-2 rounded-full bg-[#FF7B7B]"></span>
                    {{ status_value }}
                </span>
            {% else %}
                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#7FA3FF]/12 text-[#7FA3FF] border border-[#7FA3FF]/30 font-mono text-xs font-semibold">
                    <span class="w-2 h-2 rounded-full bg-[#7FA3FF] animate-pulse"></span>
                    {{ status_value }}
                </span>
            {% endif %}

            <a href="{{ path('app_audit_results', {'id': analysis.id}) }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#7FA3FF] hover:bg-[#93B4FF] text-[#0B1020] hover:text-[#0B1020] text-sm font-semibold no-underline shadow-sm hover:shadow-md hover:shadow-[#7FA3FF]/20 transition-all">
                {{ is_fr ? 'Voir résultats IA' : 'View AI Results' }} →
            </a>

            {% if is_granted('ANALYSIS_DELETE', analysis) %}
                <form method="post" action="{{ path('app_analysis_delete', {'id': analysis.id}) }}" onsubmit="return confirm('Are you sure you want to delete this audit workspace?');" class="m-0">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ analysis.id) }}">
                    <button class="inline-flex items-center px-3.5 py-2 rounded-xl bg-[#FF7B7B]/10 hover:bg-[#FF7B7B]/20 text-[#FF7B7B] border border-[#FF7B7B]/30 text-sm font-medium transition-colors cursor-pointer">
                        Delete
                    </button>
                </form>
            {% endif %}
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Commercial Proposal Card -->
        <div class="rounded-2xl bg-[#151A21] border border-[#2A323D] p-6 space-y-4">
            <div class="flex items-center justify-between gap-2">
                <h2 class="text-lg font-semibold text-[#E8ECF1] flex items-center gap-2.5 m-0">
                    <span class="w-8 h-8 rounded-lg bg-[#7FA3FF]/12 border border-[#7FA3FF]/25 flex items-center justify-center text-sm">📄</span>
                    <span>Commercial Proposal</span>
                </h2>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-[#7FA3FF]/12 text-[#7FA3FF] border border-[#7FA3FF]/25 font-mono text-[11px] font-medium">
                    PROPOSAL
                </span>
            </div>

            {% set proposalDocs = analysis.documents|filter(d => d.documentType.value == 'PROPOSAL') %}
            {% if proposalDocs is empty %}
                <p class="text-sm text-[#9BA5B3] italic">No commercial proposal attached.</p>
            {% else %}
                <ul class="space-y-3 list-none p-0 m-0">
                    {% for doc in proposalDocs %}
                        {% set ext_status = doc.extractionStatus.value %}
                        <li class="p-4 bg-[#0E1116] border border-[#2A323D] rounded-xl flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3">
                            <div class="space-y-2 min-w-0">
                                <p class="font-semibold text-sm text-[#E8ECF1] truncate m-0">{{ doc.originalFilename }}</p>
                                <p class="text-xs text-[#9BA5B3] font-mono m-0">{{ (doc.fileSize / 1024)|round(1) }} KB • {{ doc.mimeType }}</p>
                                <div class="flex flex-wrap items-center gap-2 pt-0.5">
                                    {% if ext_status == 'DONE' %}
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#4ADE9A]/12 text-[#4ADE9A] border border-[#4ADE9A]/30 text-xs font-medium">
                                            <span class="w-1.5 h-1.5 rounded-full bg-[#4ADE9A]"></span>
                                            {{ doc.extractionStatus.label }}
                                        </span>
                                    {% elseif ext_status == 'FAILED' %}
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#FF7B7B]/12 text-[#FF7B7B] border border-[#FF7B7B]/30 text-xs font-medium">
                                            <span class="w-1.5 h-1.5 rounded-full bg-[#FF7B7B]"></span>
                                            {{ doc.extractionStatus.label }}
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#F5B04A]/12 text-[#F5B04A] border border-[#F5B04A]/30 text-xs font-medium">
                                            <span class="w-1.5 h-1.5 rounded-full bg-[#F5B04A]"></span>
                                            {{ doc.extractionStatus.label }}
                                        </span>
                                    {% endif %}

                                    {% if doc.characterCount is not null %}
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-[#1B222B] border border-[#2A323D] font-mono text-[11px] text-[#B7C0CC]">
                                            {{ doc.characterCount|number_format }} chars • ~{{ doc.estimatedTokens|number_format }} tokens
                                        </span>
                                    {% endif %}
                                    {% if doc.extractionError %}
                                        <span class="text-xs text-[#FF7B7B]">{{ doc.extractionError }}</span>
                                    {% endif %}
                                </div>
                            </div>
                            <span class="self-start sm:self-center shrink-0 inline-flex items-center px-2.5 py-1 rounded-md bg-[#7FA3FF]/10 text-[#7FA3FF] border border-[#7FA3FF]/25 text-xs font-medium">
                                Commercial
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>

        <!-- Technical Specifications Card -->
        <div class="rounded-2xl bg-[#151A21] border border-[#2A323D] p-6 space-y-4">
            <div class="flex items-center justify-between gap-2">
                <h2 class="text-lg font-semibold text-[#E8ECF1] flex items-center gap-2.5 m-0">
                    <span class="w-8 h-8 rounded-lg bg-[#A99BFF]/12 border border-[#A99BFF]/25 flex items-center justify-center text-sm">📘</span>
                    <span>Technical Specifications</span>
                </h2>
                <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-[#A99BFF]/12 text-[#A99BFF] border border-[#A99BFF]/25 font-mono text-[11px] font-medium">
                    TECHNICAL_SPEC
                </span>
            </div>

            {% set techDocs = analysis.documents|filter(d => d.documentType.value == 'TECHNICAL_SPEC') %}
            {% if techDocs is empty %}
                <p class="text-sm text-[#9BA5B3] italic">No technical specification attached.</p>
            {% else %}
                <ul class="space-y-3 list-none p-0 m-0">
                    {% for doc in techDocs %}
                        {% set ext_status = doc.extractionStatus.value %}
                        <li class="p-4 bg-[#0E1116] border border-[#2A323D] rounded-xl flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3">
                            <div class="space-y-2 min-w-0">
                                <p class="font-semibold text-sm text-[#E8ECF1] truncate m-0">{{ doc.originalFilename }}</p>
                                <p class="text-xs text-[#9BA5B3] font-mono m-0">{{ (doc.fileSize / 1024)|round(1) }} KB • {{ doc.mimeType }}</p>
                                <div class="flex flex-wrap items-center gap-2 pt-0.5">
                                    {% if ext_status == 'DONE' %}
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#4ADE9A]/12 text-[#4ADE9A] border border-[#4ADE9A]/30 text-xs font-medium">
                                            <span class="w-1.5 h-1.5 rounded-full bg-[#4ADE9A]"></span>
                                            {{ doc.extractionStatus.label }}
                                        </span>
                                    {% elseif ext_status == 'FAILED' %}
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#FF7B7B]/12 text-[#FF7B7B] border border-[#FF7B7B]/30 text-xs font-medium">
                                            <span class="w-1.5 h-1.5 rounded-full bg-[#FF7B7B]"></span>
                                            {{ doc.extractionStatus.label }}
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-[#F5B04A]/12 text-[#F5B04A] border border-[#F5B04A]/30 text-xs font-medium">
                                            <span class="w-1.5 h-1.5 rounded-full bg-[#F5B04A]"></span>
                                            {{ doc.extractionStatus.label }}
                                        </span>
                                    {% endif %}

                                    {% if doc.characterCount is not null %}
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-[#1B222B] border border-[#2A323D] font-mono text-[11px] text-[#B7C0CC]">
                                            {{ doc.characterCount|number_format }} chars • ~{{ doc.estimatedTokens|number_format }} tokens
                                        </span>
                                    {% endif %}
                                    {% if doc.extractionError %}
                                        <span class="text-xs text-[#FF7B7B]">{{ doc.extractionError }}</span>
                                    {% endif %}
                                </div>
                            </div>
                            <span class="self-start sm:self-center shrink-0 inline-flex items-center px-2.5 py-1 rounded-md bg-[#A99BFF]/10 text-[#A99BFF] border border-[#A99BFF]/25 text-xs font-medium">
                                Technical
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
