{#
    Displays the EN / FR language toggle using DaisyUI join buttons
#}
{% set currentLocale = app.request.locale == 'fr' ? 'fr' : 'en' %}
<div class="join border border-base-300 rounded-full p-0.5 bg-base-200 font-mono text-xs">
    <a href="{{ path('app_switch_locale', {'locale': 'en'}) }}" class="join-item btn btn-xs rounded-full border-0 {{ currentLocale == 'en' ? 'btn-primary text-primary-content font-semibold' : 'btn-ghost text-base-content/70' }}">EN</a>
    <a href="{{ path('app_switch_locale', {'locale': 'fr'}) }}" class="join-item btn btn-xs rounded-full border-0 {{ currentLocale == 'fr' ? 'btn-primary text-primary-content font-semibold' : 'btn-ghost text-base-content/70' }}">FR</a>
</div>
