<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}PromiseGap | Evidence-Backed Contract Audit{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 28 28%22 fill=%22none%22><rect x=%222%22 y=%225%22 width=%2214%22 height=%2214%22 rx=%223%22 stroke=%22%237FA3FF%22 stroke-width=%222%22/><rect x=%2212%22 y=%229%22 width=%2214%22 height=%2214%22 rx=%223%22 stroke=%22%23B7C0CC%22 stroke-width=%222%22/></svg>">

        <!-- Google Fonts: IBM Plex Sans & IBM Plex Mono -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

        <style>
            :root {
                --bg-primary: #0E1116;
                --bg-card: #151A21;
                --bg-active: #1B222B;
                --border-subtle: #2A323D;
                --border-input: #3A4553;
                --border-hover: #4A5565;
                --text-primary: #E8ECF1;
                --text-secondary: #9BA5B3;
                --text-muted: #B7C0CC;
                --accent-blue: #7FA3FF;
                --accent-blue-hover: #A9C0FF;
                --status-sup: #4ADE9A;
                --status-con: #F5B04A;
                --status-uns: #FF7B7B;
                --status-amb: #A99BFF;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background-color: var(--bg-primary);
                color: var(--text-primary);
                font-family: 'IBM Plex Sans', system-ui, -apple-system, sans-serif;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                -webkit-font-smoothing: antialiased;
            }

            .font-mono {
                font-family: 'IBM Plex Mono', monospace;
            }

            a {
                color: var(--accent-blue);
                text-decoration: none;
                transition: color 0.15s ease;
            }

            a:hover {
                color: var(--accent-blue-hover);
            }

            /* Custom scrollbar for dark theme */
            ::-webkit-scrollbar {
                width: 8px;
                height: 8px;
            }
            ::-webkit-scrollbar-track {
                background: var(--bg-primary);
            }
            ::-webkit-scrollbar-thumb {
                background: var(--border-subtle);
                border-radius: 4px;
            }
            ::-webkit-scrollbar-thumb:hover {
                background: var(--border-input);
            }
        </style>

        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% block header %}{% endblock %}

        {% set flash_messages = app.flashes %}
        {% if flash_messages|length > 0 %}
            <div style="width: 100%; max-width: 1200px; margin: 16px auto 0; padding: 0 32px;">
                {% for label, messages in flash_messages %}
                    {% for message in messages %}
                        <div style="padding: 12px 18px; border-radius: 10px; margin-bottom: 12px; font-size: 14px; background: {% if label == 'success' %}rgba(74,222,154,0.15){% else %}rgba(255,123,123,0.15){% endif %}; border: 1px solid {% if label == 'success' %}#4ADE9A{% else %}#FF7B7B{% endif %}; color: {% if label == 'success' %}#4ADE9A{% else %}#FF7B7B{% endif %};">
                            {{ message }}
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endif %}

        <main style="flex: 1; display: flex; flex-direction: column;">
            {% block body %}{% endblock %}
        </main>

        {% block footer %}{% endblock %}
    </body>
</html>
