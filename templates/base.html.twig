<!DOCTYPE html>
<html lang="en" data-theme="dark">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}PromiseGap — Commercial Commitment Audit Engine{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🛡️</text></svg>">

        <!-- Tailwind CSS & DaisyUI (Node-free via CDN) -->
        <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.23/dist/full.min.css" rel="stylesheet" type="text/css" />
        <script src="https://cdn.tailwindcss.com"></script>

        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="min-h-screen flex flex-col bg-base-100 text-base-content">
        <!-- Barre de navigation principale -->
        <header class="navbar bg-base-200 border-b border-base-300 px-4 lg:px-8 sticky top-0 z-50">
            <div class="navbar-start">
                <div class="dropdown lg:hidden">
                    <label tabindex="0" class="btn btn-ghost btn-circle" aria-label="Open menu">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
                        </svg>
                    </label>
                    <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-200 rounded-box w-52">
                        <li><a href="/">Dashboard</a></li>
                        <li><a href="https://github.com/Gw3nhael51/promiseGap" target="_blank" rel="noopener noreferrer">GitHub</a></li>
                    </ul>
                </div>
                <a href="/" class="btn btn-ghost normal-case text-xl font-bold flex items-center gap-2">
                    <span class="text-2xl">🛡️</span>
                    <span>Promise<span class="text-primary">Gap</span></span>
                    <span class="badge badge-primary badge-sm ml-1">Beta</span>
                </a>
            </div>

            <div class="navbar-center hidden lg:flex">
                <ul class="menu menu-horizontal px-1 gap-2 font-medium">
                    <li><a href="/" class="active">Dashboard</a></li>
                    <li><a href="https://github.com/Gw3nhael51/promiseGap" target="_blank" rel="noopener noreferrer">Repository</a></li>
                </ul>
            </div>

            <div class="navbar-end gap-2">
                <!-- Sélecteur de thème DaisyUI -->
                <label class="swap swap-rotate btn btn-ghost btn-circle btn-sm" title="Toggle theme">
                    <input type="checkbox" class="theme-controller" value="light" />
                    <!-- Sun icon -->
                    <svg class="swap-off fill-current w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"/>
                    </svg>
                    <!-- Moon icon -->
                    <svg class="swap-on fill-current w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                        <path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.69Z"/>
                    </svg>
                </label>
            </div>
        </header>

        <!-- Messages Flash -->
        {% set flash_messages = app.flashes %}
        {% if flash_messages|length > 0 %}
            <div class="container mx-auto px-4 mt-4 space-y-2">
                {% for label, messages in flash_messages %}
                    {% set alert_class = 'alert-info' %}
                    {% if label == 'success' %}{% set alert_class = 'alert-success' %}
                    {% elseif label == 'error' or label == 'danger' %}{% set alert_class = 'alert-error' %}
                    {% elseif label == 'warning' %}{% set alert_class = 'alert-warning' %}
                    {% endif %}

                    {% for message in messages %}
                        <div class="alert {{ alert_class }} shadow-md flex justify-between items-center" role="alert">
                            <span>{{ message }}</span>
                        </div>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endif %}

        <!-- Contenu principal -->
        <main class="flex-grow container mx-auto px-4 py-8">
            {% block body %}{% endblock %}
        </main>

        <!-- Pied de page -->
        <footer class="footer footer-center p-6 bg-base-200 text-base-content border-t border-base-300">
            <aside>
                <p class="font-medium">PromiseGap — Catching commercial commitment gaps before contracts are signed</p>
                <p class="text-sm opacity-70">Meta Global AI Developer Hackathon 2026 (Cerebral Valley) • Powered by Symfony & Meta Model API</p>
            </aside>
        </footer>
    </body>
</html>
