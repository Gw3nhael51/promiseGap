{% extends 'base.html.twig' %}

{#
    Displays the public landing page with product overview and commitment gap comparison
#}

{% block title %}PromiseGap | Evidence-Backed Contract Audit{% endblock %}

{% block body %}
<div style="box-sizing: border-box; background: #0E1116; color: #E8ECF1; font-family: 'IBM Plex Sans', system-ui, sans-serif; display: flex; flex-direction: column;">

    <!-- Navigation Bar -->
    <header style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; width: 100%; max-width: 1200px; margin: 0 auto; box-sizing: border-box; padding: 24px 32px;">
        <a href="{{ path('app_landing') }}" style="display: flex; align-items: center; gap: 12px; text-decoration: none; color: #E8ECF1;">
            <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
                <rect x="2" y="5" width="14" height="14" rx="3" stroke="#7FA3FF" stroke-width="2"/>
                <rect x="12" y="9" width="14" height="14" rx="3" stroke="#B7C0CC" stroke-width="2"/>
            </svg>
            <span style="font-size: 18px; font-weight: 700; letter-spacing: -0.01em;">PromiseGap</span>
        </a>
        <nav style="display: flex; flex-wrap: wrap; align-items: center; gap: 24px; font-size: 14px;">
            <a href="#how" style="color: #9BA5B3; text-decoration: none;">How it works</a>
            <a href="#verdicts" style="color: #9BA5B3; text-decoration: none;">Verdicts</a>
            {% if app.user %}
                <a href="{{ path('app_cockpit') }}" style="display: inline-flex; align-items: center; gap: 8px; color: #E8ECF1; text-decoration: none;">
                    <span>Cockpit</span>
                    {% if is_granted('ROLE_ADMIN') %}
                        <span style="padding: 2px 6px; border-radius: 999px; background: rgba(245,176,74,0.2); color: #F5B04A; font-size: 11px; font-weight: 700;">ADMIN</span>
                    {% endif %}
                </a>
                <a href="{{ path('app_logout') }}" style="color: #FF7B7B; text-decoration: none;">Sign out</a>
            {% else %}
                <a href="{{ path('app_login') }}" style="color: #E8ECF1; text-decoration: none;">Sign in</a>
            {% endif %}
            <a href="{{ path('app_demo') }}" style="display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border: 1px solid #4A5565; border-radius: 10px; color: #E8ECF1; text-decoration: none;">Try a demo</a>
        </nav>
    </header>

    <!-- Hero Section -->
    <section style="width: 100%; max-width: 1200px; margin: 0 auto; box-sizing: border-box; padding: 56px 32px 96px; display: flex; flex-wrap: wrap; align-items: center; gap: 56px;">
        <div style="flex: 1 1 480px; display: flex; flex-direction: column; gap: 28px;">
            <span style="font-family: 'IBM Plex Mono', monospace; font-size: 13px; letter-spacing: 0.08em; color: #7FA3FF;">EVIDENCE-BACKED CONTRACT AUDIT</span>
            <h1 style="margin: 0; font-size: 64px; line-height: 1.04; letter-spacing: -0.03em; font-weight: 700;">Your proposal says 99.99%. Your specs say 99.5%.</h1>
            <p style="margin: 0; font-size: 19px; line-height: 1.55; color: #9BA5B3; max-width: 520px;">PromiseGap reads both documents, checks every commitment one by one, and shows the exact sentence that proves the gap, before you sign.</p>
            <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 16px;">
                <a href="{{ path('app_demo') }}" style="display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 28px; background: #7FA3FF; color: #0B1020; border-radius: 12px; font-size: 17px; font-weight: 600; text-decoration: none;">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg>
                    Try a demo
                </a>
                <a href="{{ path('app_cockpit') }}" style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 20px; border: 1px solid #4A5565; border-radius: 12px; color: #E8ECF1; font-size: 17px; text-decoration: none;">
                    Open Cockpit
                </a>
                <a href="{{ path('app_register') }}" style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 12px; color: #E8ECF1; font-size: 17px; text-decoration: none; border-bottom: 1px solid #4A5565;">
                    Create an account
                </a>
            </div>
            <span style="font-size: 14px; color: #9BA5B3;">The demo needs no account and loads a ready-made deal.</span>
        </div>

        <!-- Hero Card Comparison -->
        <div style="flex: 1 1 460px; box-sizing: border-box; display: flex; flex-direction: column; gap: 18px; padding: 24px; background: #151A21; border: 1px solid #2A323D; border-radius: 16px;">
            <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px;">
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: 12px; letter-spacing: 0.06em; color: #9BA5B3;">P1 · AVAILABILITY</span>
                <span style="display: inline-flex; align-items: center; gap: 8px; padding: 4px 12px 4px 8px; border-radius: 999px; background: rgba(245,176,74,0.14); color: #F5B04A; font-size: 13px; font-weight: 600;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4l9 16H3z"/><path d="M12 10v4"/><path d="M12 17.5v.01"/></svg>
                    Contradictory
                </span>
            </div>
            <div style="display: flex; flex-direction: column; gap: 10px; padding: 18px; background: #0E1116; border: 1px solid #2A323D; border-top: 3px solid #7FA3FF; border-radius: 12px;">
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: 12px; letter-spacing: 0.06em; color: #7FA3FF;">PROPOSAL · §2.1 · P.4</span>
                <p style="margin: 0; font-size: 17px; line-height: 1.55;">The platform delivers <mark style="background: rgba(127,163,255,0.28); color: #E8ECF1; padding: 1px 3px; border-radius: 3px;">99.99% availability</mark> backed by financial penalties.</p>
            </div>
            <div style="display: flex; align-items: center; gap: 12px; padding: 0 8px;">
                <div style="flex: 1; height: 1px; background: #3A4553;"></div>
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: #F5B04A; text-align: center;">0.49 pt gap · about 3.5 h more downtime per month</span>
                <div style="flex: 1; height: 1px; background: #3A4553;"></div>
            </div>
            <div style="display: flex; flex-direction: column; gap: 10px; padding: 18px; background: #0E1116; border: 1px solid #2A323D; border-top: 3px solid #B7C0CC; border-radius: 12px;">
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: 12px; letter-spacing: 0.06em; color: #B7C0CC;">TECH SPECS · §4.2 SLA · P.31</span>
                <p style="margin: 0; font-size: 17px; line-height: 1.55;">Target monthly availability is <mark style="background: rgba(245,176,74,0.30); color: #E8ECF1; padding: 1px 3px; border-radius: 3px;">99.5%</mark>, excluding planned maintenance.</p>
            </div>
        </div>
    </section>

    <!-- Problem Showcase -->
    <section style="background: #151A21; border-top: 1px solid #2A323D; border-bottom: 1px solid #2A323D;">
        <div style="width: 100%; max-width: 1200px; margin: 0 auto; box-sizing: border-box; padding: 80px 32px; display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start;">
            <div style="flex: 1 1 360px; display: flex; flex-direction: column; gap: 20px;">
                <h2 style="margin: 0; font-size: 40px; line-height: 1.12; letter-spacing: -0.02em; font-weight: 700;">80 pages of specs that nobody cross-reads.</h2>
                <p style="margin: 0; font-size: 17px; line-height: 1.6; color: #9BA5B3;">Sales writes the promise to close. Engineering writes what the system really does. Between the two, buyers, lawyers and CTOs rarely have time to check each line. The gap surfaces later, as penalties.</p>
            </div>
            <div style="flex: 1 1 460px; display: flex; flex-direction: column; border: 1px solid #2A323D; border-radius: 14px; overflow: hidden; background: #0E1116;">
                <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding: 18px 20px; border-bottom: 1px solid #2A323D;">
                    <span style="font-size: 18px; font-weight: 500;">Turnkey delivery in 3 months</span>
                    <span style="display: inline-flex; align-items: center; gap: 8px; padding: 4px 12px 4px 8px; border-radius: 999px; background: rgba(245,176,74,0.14); color: #F5B04A; font-size: 13px; font-weight: 600;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4l9 16H3z"/><path d="M12 10v4"/><path d="M12 17.5v.01"/></svg>Contradictory
                    </span>
                </div>
                <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding: 18px 20px; border-bottom: 1px solid #2A323D;">
                    <span style="font-size: 18px; font-weight: 500;">Real-time backup of all data</span>
                    <span style="display: inline-flex; align-items: center; gap: 8px; padding: 4px 12px 4px 8px; border-radius: 999px; background: rgba(255,123,123,0.14); color: #FF7B7B; font-size: 13px; font-weight: 600;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/></svg>Unsupported
                    </span>
                </div>
                <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding: 18px 20px; border-bottom: 1px solid #2A323D;">
                    <span style="font-size: 18px; font-weight: 500;">End-to-end encryption</span>
                    <span style="display: inline-flex; align-items: center; gap: 8px; padding: 4px 12px 4px 8px; border-radius: 999px; background: rgba(169,155,255,0.14); color: #A99BFF; font-size: 13px; font-weight: 600;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.7 9.5a2.4 2.4 0 1 1 3.4 2.2c-.7.4-1.1.9-1.1 1.6"/><path d="M12 17v.01"/></svg>Ambiguous
                    </span>
                </div>
                <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding: 18px 20px;">
                    <span style="font-size: 18px; font-weight: 500;">ISO 27001 certified hosting</span>
                    <span style="display: inline-flex; align-items: center; gap: 8px; padding: 4px 12px 4px 8px; border-radius: 999px; background: rgba(74,222,154,0.14); color: #4ADE9A; font-size: 13px; font-weight: 600;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.7 2.7L16 9.5"/></svg>Supported
                    </span>
                </div>
            </div>
        </div>
    </section>

    <!-- How It Works Section -->
    <section id="how" style="width: 100%; max-width: 1200px; margin: 0 auto; box-sizing: border-box; padding: 96px 32px; display: flex; flex-direction: column; gap: 48px;">
        <div style="display: flex; flex-direction: column; gap: 14px; max-width: 640px;">
            <span style="font-family: 'IBM Plex Mono', monospace; font-size: 13px; letter-spacing: 0.08em; color: #7FA3FF;">HOW IT WORKS</span>
            <h2 style="margin: 0; font-size: 40px; line-height: 1.12; letter-spacing: -0.02em; font-weight: 700;">From a sales sentence to a quoted verdict.</h2>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: 20px;">
            <div style="flex: 1 1 320px; box-sizing: border-box; display: flex; flex-direction: column; gap: 16px; padding: 24px; background: #151A21; border: 1px solid #2A323D; border-radius: 16px;">
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: #9BA5B3;">01 · EXTRACT</span>
                <span style="font-size: 20px; font-weight: 600;">Every commitment becomes a claim.</span>
                <pre style="margin: 0; padding: 16px; background: #0E1116; border: 1px solid #2A323D; border-radius: 10px; font-family: 'IBM Plex Mono', monospace; font-size: 13px; line-height: 1.6; color: #B7C0CC; overflow-x: auto;">{
  "id": "P1",
  "claim": "99.99% availability",
  "kind": "SLA",
  "source": "Proposal §2.1"
}</pre>
            </div>
            <div style="flex: 1 1 320px; box-sizing: border-box; display: flex; flex-direction: column; gap: 16px; padding: 24px; background: #151A21; border: 1px solid #2A323D; border-radius: 16px;">
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: #9BA5B3;">02 · SEARCH</span>
                <span style="font-size: 20px; font-weight: 600;">The specs are searched by meaning.</span>
                <div style="display: flex; flex-direction: column; gap: 12px; padding: 16px; background: #0E1116; border: 1px solid #2A323D; border-radius: 10px; font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: #B7C0CC;">
                    <div style="display: flex; flex-direction: column; gap: 6px;"><div style="display: flex; justify-content: space-between;"><span>§4.2 SLA</span><span>0.93</span></div><div style="height: 6px; border-radius: 999px; background: #2A323D;"><div style="width: 93%; height: 6px; border-radius: 999px; background: #7FA3FF;"></div></div></div>
                    <div style="display: flex; flex-direction: column; gap: 6px;"><div style="display: flex; justify-content: space-between;"><span>§4.1 Architecture</span><span>0.61</span></div><div style="height: 6px; border-radius: 999px; background: #2A323D;"><div style="width: 61%; height: 6px; border-radius: 999px; background: #7FA3FF;"></div></div></div>
                    <div style="display: flex; flex-direction: column; gap: 6px;"><div style="display: flex; justify-content: space-between;"><span>§6.1 Storage</span><span>0.41</span></div><div style="height: 6px; border-radius: 999px; background: #2A323D;"><div style="width: 41%; height: 6px; border-radius: 999px; background: #7FA3FF;"></div></div></div>
                </div>
            </div>
            <div style="flex: 1 1 320px; box-sizing: border-box; display: flex; flex-direction: column; gap: 16px; padding: 24px; background: #151A21; border: 1px solid #2A323D; border-radius: 16px;">
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: #9BA5B3;">03 · CONFRONT</span>
                <span style="font-size: 20px; font-weight: 600;">Each claim gets a verdict and a quote.</span>
                <div style="display: flex; flex-direction: column; gap: 10px; padding: 16px; background: #0E1116; border: 1px solid #2A323D; border-radius: 10px;">
                    <span style="font-family: 'IBM Plex Mono', monospace; font-size: 13px; color: #F5B04A;">verdict: contradictory · 96%</span>
                    <span style="font-size: 15px; line-height: 1.55; color: #E8ECF1;">"Target monthly availability is 99.5%."</span>
                    <span style="font-size: 13px; color: #9BA5B3;">Tech Specs §4.2 · p.31</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Verdicts Section -->
    <section id="verdicts" style="background: #151A21; border-top: 1px solid #2A323D; border-bottom: 1px solid #2A323D;">
        <div style="width: 100%; max-width: 1200px; margin: 0 auto; box-sizing: border-box; padding: 96px 32px; display: flex; flex-direction: column; gap: 40px;">
            <div style="display: flex; flex-direction: column; gap: 14px; max-width: 640px;">
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: 13px; letter-spacing: 0.08em; color: #7FA3FF;">VERDICTS</span>
                <h2 style="margin: 0; font-size: 40px; line-height: 1.12; letter-spacing: -0.02em; font-weight: 700;">Four verdicts. No vague scores.</h2>
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 20px;">
                <div style="flex: 1 1 240px; box-sizing: border-box; display: flex; flex-direction: column; gap: 12px; padding: 22px; background: #0E1116; border: 1px solid #2A323D; border-top: 3px solid #4ADE9A; border-radius: 14px;">
                    <span style="display: inline-flex; align-items: center; gap: 8px; color: #4ADE9A; font-weight: 600;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.7 2.7L16 9.5"/></svg>
                        Supported
                    </span>
                    <span style="font-size: 15px; line-height: 1.55; color: #B7C0CC;">The specs state the same thing. The matching sentence is shown.</span>
                </div>
                <div style="flex: 1 1 240px; box-sizing: border-box; display: flex; flex-direction: column; gap: 12px; padding: 22px; background: #0E1116; border: 1px solid #2A323D; border-top: 3px solid #F5B04A; border-radius: 14px;">
                    <span style="display: inline-flex; align-items: center; gap: 8px; color: #F5B04A; font-weight: 600;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4l9 16H3z"/><path d="M12 10v4"/><path d="M12 17.5v.01"/></svg>
                        Contradictory
                    </span>
                    <span style="font-size: 15px; line-height: 1.55; color: #B7C0CC;">The specs say something different. Both quotes sit side by side.</span>
                </div>
                <div style="flex: 1 1 240px; box-sizing: border-box; display: flex; flex-direction: column; gap: 12px; padding: 22px; background: #0E1116; border: 1px solid #2A323D; border-top: 3px solid #FF7B7B; border-radius: 14px;">
                    <span style="display: inline-flex; align-items: center; gap: 8px; color: #FF7B7B; font-weight: 600;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/></svg>
                        Unsupported
                    </span>
                    <span style="font-size: 15px; line-height: 1.55; color: #B7C0CC;">Nothing in the specs backs the promise. The closest section is named.</span>
                </div>
                <div style="flex: 1 1 240px; box-sizing: border-box; display: flex; flex-direction: column; gap: 12px; padding: 22px; background: #0E1116; border: 1px solid #2A323D; border-top: 3px solid #A99BFF; border-radius: 14px;">
                    <span style="display: inline-flex; align-items: center; gap: 8px; color: #A99BFF; font-weight: 600;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.7 9.5a2.4 2.4 0 1 1 3.4 2.2c-.7.4-1.1.9-1.1 1.6"/><path d="M12 17v.01"/></svg>
                        Ambiguous
                    </span>
                    <span style="font-size: 15px; line-height: 1.55; color: #B7C0CC;">The wording could be read both ways. A human decides, with the context.</span>
                </div>
            </div>
        </div>
    </section>

    <!-- Persona Section -->
    <section style="width: 100%; max-width: 1200px; margin: 0 auto; box-sizing: border-box; padding: 96px 32px; display: flex; flex-direction: column; gap: 32px;">
        <h2 style="margin: 0; font-size: 40px; line-height: 1.12; letter-spacing: -0.02em; font-weight: 700; max-width: 640px;">Built for whoever has to sign.</h2>
        <div style="display: flex; flex-direction: column; border-top: 1px solid #2A323D;">
            <div style="display: flex; flex-wrap: wrap; gap: 16px 48px; padding: 28px 0; border-bottom: 1px solid #2A323D;">
                <span style="flex: 0 0 220px; font-size: 24px; font-weight: 600;">Legal counsel</span>
                <span style="flex: 1 1 360px; font-size: 18px; line-height: 1.55; color: #9BA5B3;">Know which clauses rest on claims the documentation never makes.</span>
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 16px 48px; padding: 28px 0; border-bottom: 1px solid #2A323D;">
                <span style="flex: 0 0 220px; font-size: 24px; font-weight: 600;">CTO</span>
                <span style="flex: 1 1 360px; font-size: 18px; line-height: 1.55; color: #9BA5B3;">See where the sales promise outruns the architecture before it becomes your SLA.</span>
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 16px 48px; padding: 28px 0; border-bottom: 1px solid #2A323D;">
                <span style="flex: 0 0 220px; font-size: 24px; font-weight: 600;">Procurement</span>
                <span style="flex: 1 1 360px; font-size: 18px; line-height: 1.55; color: #9BA5B3;">Walk into the negotiation with quotes, not a feeling.</span>
            </div>
        </div>
    </section>

    <!-- Bottom CTA -->
    <section style="width: 100%; max-width: 1200px; margin: 0 auto; box-sizing: border-box; padding: 0 32px 96px;">
        <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px; padding: 56px; background: #151A21; border: 1px solid #2A323D; border-radius: 20px;">
            <div style="flex: 1 1 380px; display: flex; flex-direction: column; gap: 12px;">
                <h2 style="margin: 0; font-size: 40px; line-height: 1.12; letter-spacing: -0.02em; font-weight: 700;">Run it on your next deal.</h2>
                <span style="font-size: 17px; color: #9BA5B3;">Start with a ready-made contract, or bring your own two documents.</span>
            </div>
            <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 16px;">
                <a href="{{ path('app_demo') }}" style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 28px; background: #7FA3FF; color: #0B1020; border-radius: 12px; font-size: 17px; font-weight: 600; text-decoration: none;">Try a demo</a>
                <a href="{{ path('app_register') }}" style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 24px; border: 1px solid #4A5565; border-radius: 12px; color: #E8ECF1; font-size: 17px; text-decoration: none;">Create an account</a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer style="border-top: 1px solid #2A323D;">
        <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; width: 100%; max-width: 1200px; margin: 0 auto; box-sizing: border-box; padding: 28px 32px; font-size: 14px; color: #9BA5B3;">
            <span>PromiseGap · built at the Meta AI Hackathon</span>
            <a href="{{ path('app_login') }}" style="color: #B7C0CC; text-decoration: none;">Sign in</a>
        </div>
    </footer>

</div>
{% endblock %}
